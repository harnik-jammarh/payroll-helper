{
  "manifest_version": 3,
  "name": "Odoo Payroll Helper",
  "version": "1.0.0",
  "description": "Create workers, pay structures and attendance, calculate salary, and post the salary journal entry to Odoo.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.odoo.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Odoo Payroll Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}
